grafana:
  adminPassword: Admin@123456
  enabled: true
  service:
    type: ClusterIP

prometheus:
  prometheusSpec:
    podMonitorSelectorNilUsesHelmValues: false
    retention: 15d
    serviceMonitorSelectorNilUsesHelmValues: false
    storageSpec: {}

customRules:
  KubeNodeNotReady:
    for: 5m
    severity: warning

  KubeNodeUnreachable:
    for: 5m
    severity: warning

  KubeletInstanceUnreachable:
    for: 5m
    severity: warning

  KubeletDown:
    for: 10m
    severity: critical

  NodeCPUHighUsage:
    for: 15m
    severity: warning

# K3s embedded etcd monitoring
kubeEtcd:
  enabled: true
  endpoints:
    - 192.168.12.89
    - 192.168.12.90
    - 192.168.12.91

# K3s components are embedded / not exposed as standard standalone targets
kubeControllerManager:
  enabled: false

kubeScheduler:
  enabled: false

kubeProxy:
  enabled: false
